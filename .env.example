# Environment variables — copy this file as .env and fill in the values
# cp .env.example .env

# Secret key for Flask (sessions, CSRF). Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_hex_string

# Rate limiting
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_PER_MINUTE=3

# Site URL — used for email links and logout redirect
SITE_URL=https://yt2mp3.example.com

# Enable secure cookies (HTTPS). Set to true in production
SESSION_COOKIE_SECURE=true

# Email notifications — sent on every completed download
# Uses Gmail SMTP with an App Password (not your account password)
# To generate an App Password: myaccount.google.com → Security → 2-Step Verification → App passwords
ADMIN_EMAIL=your_email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM=your_gmail@gmail.com

# Admin panel auto-refresh interval in seconds (default: 300)
ADMIN_REFRESH_INTERVAL=300

# GeoIP database path — OPTIONAL.
# The image already bundles DB-IP City Lite, so geolocation works with no setup.
# Set this only to override it with a MaxMind GeoLite2-City file, which you must
# download yourself (free account + license key) and place in ./geoip/:
#   https://www.maxmind.com/en/geolite2/signup
GEOIP_PATH=/app/geoip/GeoLite2-City.mmdb

# Content-Security-Policy mode: enforce (default) | report-only | off
# Escape hatch if the policy ever blocks something in production; the other
# security headers apply regardless.
CSP_MODE=enforce
